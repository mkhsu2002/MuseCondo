{
  // Template. Root release supplies environment origin and secret through deployment storage.
  "name": "musecondo-tower-manager-schedule",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "MANAGER_CLOCK", "class_name": "ManagerClock"}]},
  "migrations": [{"tag": "manager-clock-v1", "new_sqlite_classes": ["ManagerClock"]}],
  "triggers": {"crons": ["0 16 * * *"]},
  "vars": {"PUBLIC_ORIGIN": "https://replace-environment.invalid"}
}
