{
  "name": "musecondo-edge-guard-template",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {"name":"BURST","namespace_id":"310001","simple":{"limit":40,"period":10}},
    {"name":"READ_IP","namespace_id":"310002","simple":{"limit":120,"period":60}},
    {"name":"WRITE_IP","namespace_id":"310003","simple":{"limit":60,"period":60}},
    {"name":"OPEN_IP","namespace_id":"310004","simple":{"limit":6,"period":60}},
    {"name":"READ_KEY","namespace_id":"310005","simple":{"limit":120,"period":60}},
    {"name":"WRITE_KEY","namespace_id":"310006","simple":{"limit":60,"period":60}},
    {"name":"GLOBAL","namespace_id":"310007","simple":{"limit":6000,"period":60}}
  ]
}
