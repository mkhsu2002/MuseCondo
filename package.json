{
  "name": "musecondo",
  "version": "1.86.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:tower",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.functions.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "test:identity": "node --experimental-strip-types --test tests/identity*.test.ts",
    "test:e2e": "playwright test",
    "manager:edit": "node --experimental-strip-types scripts/edit-community.ts",
    "dev:live": "node --experimental-strip-types server/live/local-server.ts",
    "test:live": "node --experimental-strip-types --test tests/live.test.ts tests/meta-home.test.ts tests/recovery.test.ts tests/png.test.ts tests/agent-onboarding.test.ts tests/pages-runtime.test.ts tests/legacy-home-redirect.test.ts",
    "test:framework": "node --experimental-strip-types --test tests/framework*.test.ts tests/muse-sources.test.mjs tests/public-output.test.mjs",
    "home:build": "node --experimental-strip-types scripts/build-home.ts",
    "home:sources": "node scripts/muse-sources.mjs",
    "condo:build": "node --experimental-strip-types scripts/build-condo.ts",
    "condo:verify": "node --experimental-strip-types scripts/verify-condo.ts",
    "test:condo": "node --experimental-strip-types --test tests/condo*.test.ts",
    "test:tower": "node --experimental-strip-types --test tests/tower*.test.ts tests/tower*.test.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "verify": "node scripts/verify.mjs",
    "test:native:edge": "node scripts/test-edge-guard-native.mjs",
    "test:native:mail": "node scripts/test-identity-mail-native.mjs",
    "pretypecheck": "node scripts/release-manifest.mjs --ensure",
    "pretest": "node scripts/release-manifest.mjs --ensure",
    "pretest:all": "node scripts/release-manifest.mjs --ensure",
    "release:verify": "node scripts/verify-release.mjs",
    "pretest:identity": "node scripts/release-manifest.mjs --ensure",
    "pretest:live": "node scripts/release-manifest.mjs --ensure",
    "pretest:framework": "node scripts/release-manifest.mjs --ensure",
    "pretest:condo": "node scripts/release-manifest.mjs --ensure",
    "pretest:tower": "node scripts/release-manifest.mjs --ensure",
    "pretest:native:edge": "node scripts/release-manifest.mjs --ensure",
    "pretest:native:mail": "node scripts/release-manifest.mjs --ensure",
    "test:native:assets": "node scripts/test-tower-assets-native.mjs",
    "pretest:native:assets": "node scripts/release-manifest.mjs --ensure",
    "build:tower": "node scripts/generate-lobby-css.mjs --write && node scripts/release-manifest.mjs && tsc --noEmit && vite build && node scripts/social-preview.mjs && node scripts/routes.mjs && node scripts/sanitize-public.mjs && node scripts/check-build.mjs && node scripts/release-manifest.mjs --complete",
    "build:demo": "VITE_MUSE_DEMO=1 vite build && MUSE_OUTPUT_DIR=dist-demo node scripts/routes.mjs && node scripts/sanitize-public.mjs dist-demo && node scripts/check-build.mjs dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173",
    "test:native:publications": "node scripts/test-tower-publications-native.mjs",
    "pretest:native:publications": "node scripts/release-manifest.mjs --ensure",
    "test:native:journals": "node scripts/test-tower-journals-native.mjs",
    "pretest:native:journals": "node scripts/release-manifest.mjs --ensure",
    "test:native:images": "node scripts/test-tower-images-native.mjs",
    "pretest:native:images": "node scripts/release-manifest.mjs --ensure",
    "verify:change": "node scripts/verify-change.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:native:vault": "node scripts/test-vault-native.mjs",
    "pretest:native:vault": "node scripts/release-manifest.mjs --ensure",
    "test:native:vault-notice": "node scripts/test-vault-notice-native.mjs",
    "pretest:native:vault-notice": "node scripts/release-manifest.mjs --ensure"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "eslint": "9.39.5",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@simplewebauthn/server": "14.0.3",
    "parse5": "8.0.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  }
}
