{
  "name": "musecondo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/community.test.ts",
    "test:e2e": "playwright test",
    "manager:edit": "node --experimental-strip-types scripts/edit-community.ts",
    "dev:live": "node --experimental-strip-types server/live/local-server.ts",
    "test:live": "node --experimental-strip-types --test tests/live.test.ts tests/meta-home.test.ts tests/recovery.test.ts tests/png.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
