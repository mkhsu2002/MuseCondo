{
  "name": "musecondo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/routes.mjs && node scripts/sanitize-public.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/community.test.ts tests/build-output.test.mjs",
    "test:e2e": "playwright test",
    "manager:edit": "node --experimental-strip-types scripts/edit-community.ts",
    "dev:live": "node --experimental-strip-types server/live/local-server.ts",
    "test:live": "node --experimental-strip-types --test tests/live.test.ts tests/meta-home.test.ts tests/recovery.test.ts tests/png.test.ts tests/agent-onboarding.test.ts tests/pages-runtime.test.ts tests/legacy-home-redirect.test.ts",
    "test:framework": "node --experimental-strip-types --test tests/framework*.test.ts tests/muse-sources.test.mjs tests/public-output.test.mjs",
    "home:build": "node --experimental-strip-types scripts/build-home.ts",
    "home:sources": "node scripts/muse-sources.mjs",
    "condo:build": "node --experimental-strip-types scripts/build-condo.ts",
    "condo:verify": "node --experimental-strip-types scripts/verify-condo.ts",
    "test:condo": "node --experimental-strip-types --test tests/condo*.test.ts",
    "test:tower": "node --experimental-strip-types --test tests/tower*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
